---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Reveal from '../components/Reveal.astro';
import Socials from '../components/Socials.astro';
import CvButton from '../components/CvButton.astro';
import { projects, sectionLabel, detailLabel, type Project, type Detail } from '../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props as { project: Project };
const index = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(index + 1) % projects.length];

const blocks = (['problem', 'how', 'built'] as (keyof Detail)[]).map((k) => ({
  key: detailLabel[k],
  text: project.detail[k],
}));

const meta: { k: string; v: string; accent?: boolean }[] = [
  { k: 'Rol', v: project.role },
  { k: 'Año', v: project.year },
  { k: 'Stack', v: project.tech.join(' · ') },
];
if (project.status) meta.push({ k: 'Estado', v: project.status, accent: true });
---
<Base title={project.name} description={project.context}>
  <Header back />

  <section class="section section--light">
    <div class="inner">
      <Reveal><p class="label">{sectionLabel[project.section]}</p></Reveal>
      <Reveal delay={60}>
        <h1
          class:list={['item', project.size === 86 ? 'item--86' : 'item--58']}
          transition:name={`title-${project.slug}`}
        >
          {project.name}
        </h1>
      </Reveal>
      <Reveal delay={140}><p class="caption caption--lead">{project.context}</p></Reveal>
    </div>
  </section>

  <section class="section section--dark">
    <div class="inner">
      <div class="blocks">
        {blocks.map((b, i) => (
          <div class="block">
            <Reveal delay={i * 80}><p class="block__key">{b.key}</p></Reveal>
            <Reveal delay={i * 80 + 60}><p class="block__text">{b.text}</p></Reveal>
          </div>
        ))}
      </div>
    </div>
  </section>

  {project.links && (
    <section class="section section--light">
      <div class="inner">
        <Reveal><p class="label">Disponible en</p></Reveal>
        <div class="stores">
          {project.links.map((l, i) => (
            <Reveal delay={i * 70}>
              <a class="store" href={l.url} target="_blank" rel="noopener">
                {l.kind === 'appstore' && (
                  <svg class="store__mark" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                    <path d="M16.4 12.7c0-2.2 1.8-3.3 1.9-3.4-1-1.5-2.6-1.7-3.2-1.7-1.3-.1-2.6.8-3.3.8-.7 0-1.7-.8-2.8-.7-1.5 0-2.8.9-3.5 2.2-1.5 2.6-.4 6.5 1.1 8.6.7 1 1.6 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7 1.3 0 1.6.7 2.8.7 1.1 0 1.9-1.1 2.6-2.1.8-1.2 1.1-2.3 1.2-2.4-.1 0-2.3-.9-2.3-3.5ZM14.3 5.9c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.6 1 .1 2-.5 2.5-1.2Z"/>
                  </svg>
                )}
                <span class="store__text">
                  <span class="store__label">{l.label}</span>
                  <span class="store__host">{new URL(l.url).host}</span>
                </span>
                <span class="store__arrow" aria-hidden="true">↗</span>
              </a>
            </Reveal>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--alt">
    <div class="inner">
      <Reveal><p class="label">Ficha</p></Reveal>
      <dl class="meta">
        {meta.map((m, i) => (
          <Reveal delay={i * 60}>
            <div class="meta__row">
              <dt class="meta__key">{m.k}</dt>
              <dd class:list={['meta__val', m.accent && 'meta__val--accent']}>{m.v}</dd>
            </div>
          </Reveal>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--light">
    <div class="inner">
      <Reveal><p class="label">Siguiente</p></Reveal>
      <Reveal delay={60}>
        <a href={`/${next.slug}/`} class:list={['item', next.size === 86 ? 'item--86' : 'item--58']}>
          {next.name}
        </a>
      </Reveal>
      <Reveal delay={120}><div class="cv-slot"><CvButton /></div></Reveal>
      <Socials />
    </div>
  </section>
</Base>
