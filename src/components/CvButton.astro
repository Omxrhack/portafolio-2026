---
import { site } from '../data/projects';

interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<a
  class:list={['cv', compact && 'cv--compact']}
  href={site.cv.href}
  download={site.cv.file}
  aria-label={`Descargar CV en PDF, ${site.cv.pages}, ${site.cv.size}`}
>
  <span class="cv__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5" stroke-linecap="square" />
      <path d="M4 20h16" stroke-linecap="square" />
    </svg>
  </span>
  <span class="cv__text">
    <span class="cv__label">Descargar CV</span>
    {!compact && <span class="cv__meta">PDF · {site.cv.pages} · {site.cv.size}</span>}
  </span>
</a>
